{
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  // "height": 30, // Waybar height (to be removed for auto height)
  "margin": "5 20 0 20",
  // "width": 1280, // Waybar width
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces", "hyprland/language", "keyboard-state", "custom/pacman"],
  "modules-center": ["clock", "custom/weather", "custom/power_btn"],
  "modules-right": ["pulseaudio", "pulseaudio#microphone", "cpu", "memory", "temperature", "backlight", "battery", "tray"],


  //***************************
  //*  Modules configuration  *
  //***************************

  // Left
  "hyprland/language": {
    "format": "{}",
    "min-length": 5,
    "tooltip": false
  },

    "keyboard-state": {
    // "numlock": true,
    "min-length": "50px",
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },

  "custom/pacman": {
    "format": "{} ",
    "interval": 3600,                     			// every hour
    "exec":  "~/.config/waybar/scripts/update-sys",	// # of updates
    "exec-if": "exit 0",                  			// always run; consider advanced run conditions
    "on-click": "~/.config/waybar/scripts/update-sys update",
    "signal": 8,
    "tooltip": false
  },

  // Center
  "clock": {
    // "timezone": "America/New_York",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%a, %d %b, %I:%M %p}"
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 1800,
    "exec": "$HOME/.config/waybar/scripts/wttr.py",
    "return-type": "json"
  },

  "custom/power_btn": {
    "format": "",
    "on-click": "sh -c '(sleep 0.5s; wlogout -C .config/wlogout/nova.css --protocol layer-shell)' & disown",
    "tooltip": false
  },

  // Right
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "on-click": "~/.config/waybar/scripts/volume --toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "~/.config/waybar/scripts/volume --inc",
    "on-scroll-down": "~/.config/waybar/scripts/volume --dec",
    "scroll-step": 1,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "~/.config/waybar/scripts/volume --toggle-mic",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "~/.config/waybar/scripts/volume --mic-inc",
    "on-scroll-down": "~/.config/waybar/scripts/volume --mic-dec",
    "scroll-step": 5
  },

  "cpu": {
    "interval": 10,
    "format": "{}%  ",
    "format-alt-click": "click-right",
    "format-alt": " {usage}%"
  },

  "memory": {
    "interval": 30,
    "format": "{}%  ",
    "tooltip": true,
    "tooltip-format": "Memory - {used:0.1f}GB used"
  },

  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "min-length": 7
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 0
  }
}
