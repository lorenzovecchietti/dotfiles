# ==============================================================================
# HYPRLAND CONFIGURATION FILE
# ==============================================================================

# Source external files (e.g., colors, separate keybinds)
# source = ~/.config/hypr/myColors.conf

# ------------------------------------------------------------------------------
# 🖥️ MONITORS
# See: https://wiki.hyprland.org/Configuring/Monitors/
# ------------------------------------------------------------------------------
monitor = ,preferred,auto,1

# Example: Dual monitor setup on G15 Strix
# eDP-1 is the built-in monitor, DP-1 is the external one.
# monitor = DP-1,2560x1440@165,0x0,1
# monitor = eDP-1,2560x1440@165,2560x0,1.25


# ------------------------------------------------------------------------------
# 🚀 AUTOSTART (exec-once)
# Execute essential apps and background services at launch
# ------------------------------------------------------------------------------
exec-once = ~/.config/hypr/scripts/xdg-portal-hyprland               # Start correct XDG portal
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP # Wayland magic for screen sharing
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP          # Additional Wayland magic
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 # Polkit for graphical sudo elevation
exec-once = waybar                                                    # Top status bar
exec-once = blueman-applet                                            # Bluetooth systray applet
exec-once = nm-applet --indicator                                     # Network/Wi-Fi systray applet
exec-once = awww-daemon                                               # Wallpaper daemon


# ------------------------------------------------------------------------------
# ⌨️ INPUT DEVICES
# Keyboard, mouse, and touchpad configuration
# See: https://wiki.hyprland.org/Configuring/Variables/#input
# ------------------------------------------------------------------------------
input {
    kb_layout = us,it
    kb_variant =
    kb_model =
    kb_options = grp:alt_space_toggle
    kb_rules =

    follow_mouse = 1
    sensitivity = 0 # Ranging from -1.0 to 1.0 (0 means no modification)

    touchpad {
        natural_scroll = yes
        tap-to-click = true
    }
}


# ------------------------------------------------------------------------------
# 🎨 GENERAL & DECORATION
# Gaps, borders, colors, and visual effects (blur, rounding)
# ------------------------------------------------------------------------------
general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    
    col.active_border = rgb(cdd6f4)
    col.inactive_border = rgba(595959aa)

    layout = dwindle
}

decoration {
    rounding = 5
    
    blur {
        enabled = true
        size = 5
        passes = 1
        vibrancy = 0.1696
        new_optimizations = true
    }   
}

misc {
    disable_hyprland_logo = yes
}


# ------------------------------------------------------------------------------
# 💫 ANIMATIONS
# Custom bezier curves and animation speeds
# See: https://wiki.hyprland.org/Configuring/Animations/
# ------------------------------------------------------------------------------
animations {
    enabled = yes

    # Define custom curve
    bezier = myBezier, 0.10, 0.9, 0.1, 1.05

    # Apply animations to specific events
    animation = windows, 1, 10, myBezier, slide
    animation = windowsOut, 1, 7, myBezier, slide
    animation = border, 1, 10, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}


# ------------------------------------------------------------------------------
# 🪟 LAYOUTS & GESTURES
# Settings for Dwindle/Master layouts and trackpad gestures
# ------------------------------------------------------------------------------
dwindle {
    preserve_split = true
}

master {
    new_status = master
}

# Workspace swipe gesture
gesture = 3, horizontal, workspace


# ------------------------------------------------------------------------------
# 📜 WINDOW RULES
# Specific behaviors for targeted application windows
# ------------------------------------------------------------------------------
# -- Floating Rules --
windowrule = match:class ^(pavucontrol)$, float 1
windowrule = match:class ^(blueman-manager)$, float 1
windowrule = match:class ^(nm-connection-editor)$, float 1
windowrule = match:class ^(chromium)$, float 1
windowrule = match:class ^(thunar)$, float 1
windowrule = match:title ^(btop)$, float 1
windowrule = match:title ^(update-sys)$, float 1

# -- Custom Animations --
windowrule = match:class ^(kitty)$, match:title ^(update-sys)$, animation popin
windowrule = match:class ^(thunar)$, animation popin
windowrule = match:class ^(wofi)$, animation slide

# -- Style & Opacity --
windowrule = match:class ^(wofi)$, opacity 1 1
windowrule = match:float 1, rounding 10

# -- Positioning --
windowrule = match:class ^(wofi)$, match:title ^(clippick)$, move 100%-433 53


# ------------------------------------------------------------------------------
# 🌫️ LAYER RULES
# Rules for UI elements like Waybar, Wofi, Notifications, etc.
# ------------------------------------------------------------------------------
# -- Blur Background --
layerrule = match:namespace ^(swaync-control-center)$, blur 1
layerrule = match:namespace ^(swaync-notification-window)$, blur 1
layerrule = match:namespace ^(logout_dialog)$, blur 1
layerrule = match:namespace ^(wofi)$, blur 1
layerrule = match:namespace ^(waybar)$, blur 1
layerrule = match:namespace ^(lockscreen)$, blur 1

# -- Ignore Alpha (Prevent blurring fully transparent pixels) --
layerrule = ignore_alpha 0, match:namespace swaync-control-center
layerrule = ignore_alpha 0, match:namespace swaync-notification-window


# ------------------------------------------------------------------------------
# ⌨️ KEYBINDINGS
# Modifier keys, app launchers, and window management
# See: https://wiki.hyprland.org/Configuring/Binds/
# ------------------------------------------------------------------------------
$mainMod = SUPER

# -- Essential Apps & Actions --
bind = $mainMod, Q, exec, kitty                           # Open terminal
bind = $mainMod, SPACE, exec, wofi                        # Open app launcher
bind = $mainMod, E, exec, thunar                          # Open file manager
bind = $mainMod, S, exec, grim -g "$(slurp)" - | swappy -f - # Take screenshot
bind = $mainMod, L, exec, swaylock                        # Lock screen
bind = $mainMod, M, exec, wlogout --protocol layer-shell  # Show logout menu
bind = $mainMod SHIFT, M, exit,                           # Force quit Hyprland

# -- Window Management --
bind = $mainMod, F4, killactive,                          # Close active window
bind = $mainMod, V, togglefloating,                       # Toggle floating mode
bind = $mainMod, P, pseudo,                               # Toggle pseudotile (Dwindle)

# -- Focus Navigation (Arrow Keys) --
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# -- Workspace Navigation --
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# -- Move Active Window to Workspace --
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# -- Scroll Through Workspaces --
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# -- Mouse Window Manipulation (Drag) --
bindm = $mainMod, mouse:272, movewindow   # Left-click & drag to move
bindm = $mainMod, mouse:273, resizewindow # Right-click & drag to resize
